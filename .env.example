# ---- 模型接入（必填一项 key；任意 OpenAI 兼容端点均可，含国产模型）----
# 例：DeepSeek 填 https://api.deepseek.com + deepseek-chat
OPENAI_API_KEY=在这里填你的密钥
OPENAI_BASE_URL=
DEEPRESEARCH_MODEL=gpt-4o-mini

# 结构化输出的首选实现方式：function_calling（默认）/ json_mode / prompted。
# 实际调用会自动降级（首选 → json_mode → prompted），一般不用改。
# DeepSeek 思考型模型不支持强制 tool_choice，会自动落到 json_mode；
# 若想跳过第一次失败的尝试，可直接填 DEEPRESEARCH_STRUCTURED_MODE=json_mode。
DEEPRESEARCH_STRUCTURED_MODE=function_calling

# ---- 观测（可选）----
# 三项都填才会把 LLM 调用上报到 Langfuse；不填则只用本地 UsageTracker 记录指标。
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ---- 检索层 ----
# 嵌入模型：三项都填才启用真实嵌入；不填则用本地哈希嵌入（离线可用、无成本）
# 例：EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#     EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=

# Qdrant：不填 QDRANT_URL 则用本地嵌入式模式（无需部署）
# QDRANT_URL=http://127.0.0.1:6333
QDRANT_LOCAL_PATH=.qdrant
QDRANT_COLLECTION=docs

# 检索条数与引用覆盖率门槛
DEEPRESEARCH_TOP_K=4
DEEPRESEARCH_MIN_COVERAGE=0.6

# 成本估算（每百万 token 单价，按你的模型填；不填则估算为 0）
# DEEPRESEARCH_PRICE_IN=1.0
# DEEPRESEARCH_PRICE_OUT=2.0

# ---- 持久化 ----
# 默认 SQLite，进程重启可从断点恢复；生产环境可换 Postgres：
# DATABASE_URL=postgresql://user:pass@localhost:5432/deepresearch
DEEPRESEARCH_CHECKPOINT_DB=data/checkpoints.sqlite
